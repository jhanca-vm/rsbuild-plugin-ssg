{
  "name": "rsbuild-plugin-ssg",
  "version": "1.1.0",
  "description": "Static Site Generation plugin for Rsbuild.",
  "keywords": [
    "islands-architecture",
    "preact",
    "prerender",
    "react",
    "rsbuild-plugin",
    "ssg",
    "svelte",
    "vue"
  ],
  "homepage": "https://github.com/jhanca-vm/rsbuild-plugin-ssg#readme",
  "bugs": {
    "url": "https://github.com/jhanca-vm/rsbuild-plugin-ssg/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhanca-vm/rsbuild-plugin-ssg.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "playwright test --workers=1",
    "build": "rslib"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rsbuild/core": "2.2.7",
    "@rsbuild/plugin-preact": "2.1.0",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-svelte": "2.0.1",
    "@rsbuild/plugin-vue": "2.0.1",
    "@rslib/core": "1.0.1",
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "preact": "10.29.8",
    "preact-render-to-string": "6.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svelte": "5.57.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vue": "3.5.43"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=2.0.0"
  }
}
